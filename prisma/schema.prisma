generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  fullName  String
  title     String?
  username  String?
  isGuest   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Project {
  id        Int      @id @default(autoincrement())
  title     String
  priority  String   @default("No priority")
  lead      String   @default("Admin")
  dueDate   String?
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      String
  priority    String?  @default("No priority")
  assignee    String?
  date        String?
  labels      String   @default("[]")
  reporter    String?
  teams       String?

  projectId   Int?
  project     Project? @relation(fields: [projectId], references: [id])

  subtasks    Subtask[]
  updates     Update[]
  comments    Comment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subtask {
  id         Int    @id @default(autoincrement())
  task       String
  priority   String @default("No priority")
  member     String?
  dueDate    String?

  taskId     Int
  parentTask Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Update {
  id        Int      @id @default(autoincrement())
  text      String
  timestamp String

  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Comment {
  id        Int      @id @default(autoincrement())
  author    String
  text      String
  timestamp String

  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  parentCommentId Int?
  parentComment   Comment?  @relation("Replies", fields: [parentCommentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies         Comment[] @relation("Replies")
}